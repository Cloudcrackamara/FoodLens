# Copy to frontend/.env.local and adjust. Never commit .env.local.
# FastAPI origin that Next.js proxies /api/* to.
BACKEND_URL=http://localhost:8000

# Cloudflare Tunnel (phone testing, later deployment). When true, the visitor IP is taken from
# CF-Connecting-IP, but only on connections from CLOUDFLARED_IPS (docs/DECISIONS.md D90).
TRUST_CLOUDFLARE_TUNNEL=false
# Exact addresses cloudflared connects from (local quick tunnel: 127.0.0.1,::1).
CLOUDFLARED_IPS=127.0.0.1,::1

# Wholesale order requests are hidden future work (D127). Must match the backend ORDERS_ENABLED.
NEXT_PUBLIC_ORDERS_ENABLED=false
