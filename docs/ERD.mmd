erDiagram

    APP_USER {
        uuid user_id PK
        string email UK "stored lowercased"
        string password_hash
        string display_name
        boolean is_admin "seed/CLI only"
        boolean is_active
        datetime created_at
        datetime updated_at
    }

    USER_SESSION {
        uuid session_id PK
        uuid user_id FK
        string token_hash UK "hash only"
        datetime expires_at
        datetime revoked_at "nullable"
        datetime created_at
    }

    COMPANY {
        uuid company_id PK
        boolean is_manufacturer "at least one flag true"
        boolean is_distributor
        boolean is_retailer
        string display_name
        string contact_email
        string contact_phone "nullable"
        string claimed_legal_name "claimed, unverified"
        string claimed_business_identifier "nullable"
        string claimed_address "nullable"
        enum review_status "PENDING_REVIEW, APPROVED, REJECTED, SUSPENDED"
        uuid reviewed_by_user_id FK "nullable"
        datetime reviewed_at "nullable"
        string review_note "nullable"
        datetime created_at
        datetime updated_at
    }

    COMPANY_MEMBER {
        uuid member_id PK
        uuid user_id FK,UK "one company per user"
        uuid company_id FK
        enum role "OWNER, STAFF"
        enum membership_status "ACTIVE, INACTIVE"
        boolean is_public_contact
        string public_title "nullable"
        string public_phone "nullable"
        string public_email "nullable"
        datetime created_at
        datetime updated_at
    }

    SUPPLIER_LOCATION {
        uuid location_id PK
        uuid company_id FK
        string name
        string address
        string area "display text"
        uuid area_id FK "coarse area for events"
        uuid contact_member_id FK "nullable"
        enum review_status "PENDING_REVIEW, APPROVED, REJECTED"
        uuid reviewed_by_user_id FK "nullable"
        datetime reviewed_at "nullable"
        string review_note "nullable"
        datetime created_at
        datetime updated_at
    }

    AREA {
        uuid area_id PK
        string city "UK with state"
        string state
        decimal latitude "city centre, not a person"
        decimal longitude
        datetime created_at
    }

    PRODUCT {
        uuid product_id PK
        uuid company_id FK "approved manufacturer"
        string name
        string brand
        string category
        string product_code UK
        string size "nullable"
        jsonb attributes "max 20 keys"
        string gtin "nullable, GS1 check digit, UK per company"
        string manufacturer_name
        text label_information "nullable"
        string registration_number "as printed, information only"
        enum status "DRAFT, PENDING_REVIEW, PUBLISHED, REJECTED, DISCONTINUED"
        uuid reviewed_by_user_id FK "nullable"
        datetime reviewed_at "nullable"
        string review_note "nullable"
        datetime created_at
        datetime updated_at
    }

    PRODUCT_BATCH {
        uuid batch_id PK
        uuid product_id FK "UK with batch_number"
        string batch_number
        date production_date "nullable"
        date expiry_date "nullable, >= production_date"
        datetime released_at "nullable, cache"
        enum review_status "PENDING_REVIEW, APPROVED, REJECTED"
        uuid reviewed_by_user_id FK "nullable"
        datetime reviewed_at "nullable"
        string review_note "nullable"
        datetime created_at
        datetime updated_at
    }

    CARTON {
        uuid carton_id PK
        uuid batch_id FK
        uuid manufacturer_id FK
        string carton_ref "UK with batch_id, labels only"
        string qr_token_hash UK "sha256 hex, CHECK, never raw"
        enum lifecycle_status "derived"
        uuid current_holder_company_id FK "derived"
        datetime created_at
        datetime updated_at
    }

    PRODUCT_UNIT {
        uuid unit_id PK
        uuid batch_id FK
        uuid product_id FK
        uuid manufacturer_id FK
        uuid parent_carton_id FK "nullable"
        string qr_token_hash UK "sha256 hex of normalised token, CHECK, never raw"
        enum lifecycle_status "ISSUED, RELEASED, IN_TRANSIT, IN_STOCK, SOLD, RECALLED, VOIDED"
        uuid current_holder_company_id FK "derived"
        datetime last_sold_at "derived, nullable"
        uuid last_sold_area_id FK "derived, nullable"
        uuid last_sold_company_id FK "derived, nullable"
        datetime created_at
        datetime updated_at
    }

    LIFECYCLE_EVENT {
        uuid event_id PK "append-only, trigger refuses UPDATE and DELETE"
        uuid unit_id FK "exactly one of unit/carton"
        uuid carton_id FK "exactly one of unit/carton"
        uuid group_id "carton or bulk action"
        enum event_type "ISSUED, RELEASED, TRANSFERRED, RECEIVED, SOLD, RETURNED, SALE_CORRECTED, RECALLED, VOIDED"
        enum source "MANUFACTURER, MERCHANT_APP, POS_API, CONSUMER_CHECK, SYSTEM"
        uuid actor_user_id FK "nullable"
        uuid actor_company_id FK "nullable"
        uuid retailer_company_id FK "nullable"
        uuid to_company_id FK "required for TRANSFERRED"
        uuid pos_partner_id FK "nullable"
        string till_ref "nullable"
        uuid area_id FK "nullable"
        datetime occurred_at
        datetime recorded_at
        string transaction_ref "nullable, UK with partner+unit+type"
        string payment_reference "nullable, opaque"
        text reason "SALE_CORRECTED, VOIDED"
        uuid corrects_event_id FK "nullable"
        boolean received_without_transfer
        boolean outside_allocation "RECEIVED only, note, no alert"
        uuid returns_event_id FK "nullable, SOLD reversed"
        datetime created_at
    }

    BATCH_ALLOCATION {
        uuid allocation_id PK
        uuid batch_id FK
        uuid destination_company_id FK "nullable"
        uuid destination_area_id FK
        int quantity "> 0"
        date planned_date "nullable"
        uuid created_by_user_id FK
        datetime created_at
        datetime updated_at
    }

    ALLOCATION_CARTON {
        uuid allocation_carton_id PK
        uuid allocation_id FK
        uuid carton_id FK,UK "one allocation per carton"
        datetime created_at
    }

    ALLOCATION_UNIT {
        uuid allocation_unit_id PK
        uuid allocation_id FK
        uuid unit_id FK,UK "one allocation per unit"
        datetime created_at
    }

    RATE_LIMIT_DAILY {
        uuid rate_limit_id PK
        uuid area_id FK "nullable, UK with day+bucket, nulls not distinct"
        date day
        enum bucket "CHECK, REPORT, LOGIN, REGISTER, POS"
        int count ">= 0, no IP column"
        datetime created_at
        datetime updated_at
    }

    SCAN_EVENT {
        uuid scan_id PK "no IP, UA, cookie, device, GPS; trigger refuses UPDATE"
        enum identifier_type "QR, TYPED"
        uuid unit_id FK "nullable"
        uuid carton_id FK "nullable"
        uuid area_id FK "coarse, nullable"
        enum result "D115 results"
        datetime created_at "purged after 12 months"
    }

    RISK_ALERT {
        uuid alert_id PK
        enum rule "R1..R9"
        enum level "LOW, MEDIUM, HIGH"
        uuid manufacturer_id FK "null = admin only"
        uuid unit_id FK "nullable"
        uuid carton_id FK "nullable"
        uuid batch_id FK "required for rule 9"
        uuid area_id FK "required for rule 9"
        jsonb evidence "ids, snapshot, explanation"
        enum status "OPEN, INVESTIGATING, RESOLVED_LEGITIMATE, RESOLVED_SUSPECTED_COPY"
        text notes "nullable"
        uuid resolved_by_user_id FK "nullable"
        datetime resolved_at "nullable"
        datetime created_at
        datetime updated_at
    }

    CONSUMER_REPORT {
        uuid report_id PK "anonymous"
        uuid unit_id FK "nullable"
        uuid manufacturer_id FK "nullable"
        enum concern_type
        text description "max 1000, CHECK"
        uuid area_id FK "nullable"
        enum status "NEW, REVIEWED, CLOSED"
        datetime created_at
        datetime updated_at
    }

    POS_PARTNER {
        uuid partner_id PK
        string name
        enum status "ACTIVE, SUSPENDED"
        string signing_secret_encrypted "Fernet, POS_SECRET_KEY"
        uuid created_by_user_id FK "admin"
        datetime created_at
        datetime updated_at
    }

    POS_PARTNER_KEY {
        uuid key_id PK
        uuid partner_id FK
        string key_prefix "display only"
        string key_hash UK "sha256 hex, CHECK"
        datetime revoked_at "nullable"
        datetime created_at
    }

    POS_PARTNER_RETAILER {
        uuid link_id PK
        uuid partner_id FK "UK with retailer"
        uuid retailer_company_id FK
        enum status "ACTIVE, REVOKED"
        uuid created_by_user_id FK "admin"
        datetime created_at
        datetime updated_at
    }

    POS_TILL {
        uuid till_id PK
        uuid partner_id FK "UK with retailer+till_ref"
        uuid retailer_company_id FK
        string till_ref
        uuid location_id FK "reviewed location"
        datetime created_at
    }

    CHANGE_NOTICE {
        uuid notice_id PK
        uuid company_id FK
        uuid product_id FK "exactly one target set"
        uuid batch_id FK "exactly one target set"
        uuid location_id FK "exactly one target set"
        enum change_type
        text reason
        date effective_date "nullable"
        uuid submitted_by_user_id FK
        enum review_status "PENDING_REVIEW, CLARIFICATION_REQUESTED, APPROVED, REJECTED"
        uuid reviewed_by_user_id FK "nullable"
        datetime reviewed_at "nullable"
        string review_note "nullable"
        datetime created_at
        datetime updated_at
    }

    CHANGE_NOTICE_FIELD {
        uuid field_change_id PK
        uuid notice_id FK "UK with field_name"
        string field_name
        text current_value "snapshot"
        text proposed_value
        text applied_old_value "set on approval"
        datetime created_at
    }

    NOTICE_ATTACHMENT {
        uuid attachment_id PK
        uuid notice_id FK
        string storage_key UK "private"
        string original_filename
        enum mime_type "application/pdf, image/png, image/jpeg"
        int size_bytes "1 to 5 MB"
        datetime created_at
    }

    PRODUCT_ANNOUNCEMENT {
        uuid announcement_id PK
        uuid product_id FK
        uuid batch_id FK "nullable, recall target"
        enum kind "NOTICE, RECALL"
        string title
        text message
        text recall_reason "required for RECALL"
        string image_storage_key "nullable, unused"
        enum status "LIVE, HIDDEN"
        uuid created_by_user_id FK
        uuid hidden_by_user_id FK "nullable"
        datetime hidden_at "nullable"
        datetime created_at
        datetime updated_at
    }

    AUDIT_LOG {
        uuid audit_id PK
        uuid actor_user_id FK "nullable for system"
        string entity_type
        uuid entity_id
        string action
        jsonb old_values "nullable"
        jsonb new_values "nullable"
        datetime created_at
    }

    WHOLESALE_ORDER {
        uuid order_id PK "HIDDEN, future work"
        uuid buyer_company_id FK
        uuid seller_company_id FK
        uuid created_by_user_id FK
        uuid pickup_location_id FK "nullable"
        enum fulfilment_method "PICKUP, DELIVERY"
        text delivery_details "nullable"
        enum status "REQUESTED, ACCEPTED, DECLINED, FULFILLED, CANCELLED"
        text buyer_note "nullable"
        text seller_note "nullable"
        datetime created_at
        datetime updated_at
    }

    ORDER_LINE {
        uuid line_id PK "HIDDEN"
        uuid order_id FK
        uuid product_id FK
        decimal quantity "> 0"
        string unit
        datetime created_at
    }

    ORDER_BATCH_ALLOCATION {
        uuid allocation_id PK "HIDDEN"
        uuid line_id FK
        uuid batch_id FK
        datetime created_at
    }

    APP_USER ||--o{ USER_SESSION : "signs in with"
    APP_USER ||--o| COMPANY_MEMBER : "belongs via"
    COMPANY ||--o{ COMPANY_MEMBER : "has"
    COMPANY ||--o{ SUPPLIER_LOCATION : "operates"
    AREA ||--o{ SUPPLIER_LOCATION : "located in"
    COMPANY ||--o{ PRODUCT : "manufactures"
    PRODUCT ||--o{ PRODUCT_BATCH : "has"
    PRODUCT_BATCH ||--o{ CARTON : "packed in"
    PRODUCT_BATCH ||--o{ PRODUCT_UNIT : "issues"
    CARTON o|--o{ PRODUCT_UNIT : "contains"
    COMPANY o|--o{ PRODUCT_UNIT : "currently holds"
    PRODUCT_UNIT o|--o{ LIFECYCLE_EVENT : "history"
    CARTON o|--o{ LIFECYCLE_EVENT : "history"
    LIFECYCLE_EVENT o|--o| LIFECYCLE_EVENT : "corrects or returns"
    PRODUCT_BATCH ||--o{ BATCH_ALLOCATION : "allocated by"
    COMPANY o|--o{ BATCH_ALLOCATION : "destination"
    AREA ||--o{ BATCH_ALLOCATION : "destination area"
    BATCH_ALLOCATION ||--o{ ALLOCATION_CARTON : "lists"
    CARTON ||--o| ALLOCATION_CARTON : "allocated in"
    BATCH_ALLOCATION ||--o{ ALLOCATION_UNIT : "lists"
    PRODUCT_UNIT ||--o| ALLOCATION_UNIT : "allocated in"
    AREA o|--o{ RATE_LIMIT_DAILY : "counted in"
    PRODUCT_BATCH o|--o{ RISK_ALERT : "rule 9 subject"
    AREA o|--o{ LIFECYCLE_EVENT : "where"
    PRODUCT_UNIT o|--o{ SCAN_EVENT : "checked as"
    AREA o|--o{ SCAN_EVENT : "coarse area"
    PRODUCT_UNIT o|--o{ RISK_ALERT : "subject of"
    COMPANY o|--o{ RISK_ALERT : "manufacturer sees"
    PRODUCT_UNIT o|--o{ CONSUMER_REPORT : "reported"
    POS_PARTNER ||--o{ POS_PARTNER_KEY : "authenticates with"
    POS_PARTNER ||--o{ POS_PARTNER_RETAILER : "linked to"
    COMPANY ||--o{ POS_PARTNER_RETAILER : "retailer in"
    POS_PARTNER ||--o{ POS_TILL : "registers"
    SUPPLIER_LOCATION ||--o{ POS_TILL : "till at"
    POS_PARTNER o|--o{ LIFECYCLE_EVENT : "recorded via"
    COMPANY ||--o{ CHANGE_NOTICE : "submits"
    PRODUCT o|--o{ CHANGE_NOTICE : "target"
    PRODUCT_BATCH o|--o{ CHANGE_NOTICE : "target"
    SUPPLIER_LOCATION o|--o{ CHANGE_NOTICE : "target"
    CHANGE_NOTICE ||--|{ CHANGE_NOTICE_FIELD : "proposes"
    CHANGE_NOTICE ||--o{ NOTICE_ATTACHMENT : "supported by"
    PRODUCT ||--o{ PRODUCT_ANNOUNCEMENT : "announced in"
    PRODUCT_BATCH o|--o{ PRODUCT_ANNOUNCEMENT : "recall target"
    APP_USER o|--o{ AUDIT_LOG : "acts in"
    COMPANY ||--o{ WHOLESALE_ORDER : "buys in (hidden)"
    COMPANY ||--o{ WHOLESALE_ORDER : "sells in (hidden)"
    WHOLESALE_ORDER ||--|{ ORDER_LINE : "contains"
    PRODUCT ||--o{ ORDER_LINE : "ordered as"
    ORDER_LINE ||--o{ ORDER_BATCH_ALLOCATION : "fulfilled by"
    PRODUCT_BATCH ||--o{ ORDER_BATCH_ALLOCATION : "allocated in"
    SUPPLIER_LOCATION o|--o{ WHOLESALE_ORDER : "pickup at"

%% Schema built by migrations 0006_unit_identity and 0007_drop_register (Phase 1, 2026-10-22; D104-D147).
%% REGULATOR_REGISTER, REGULATORY_AGENCY and BATCH_SCAN are dropped; earlier ERD in git history (28d4fb6).
%% QR only, no hidden codes (D138). Raw QR tokens, POS keys and secrets are never stored; only hashes (POS signing secret encrypted).
%% Every reviewer FK (reviewed_by_user_id, hidden_by_user_id, resolved_by_user_id) references APP_USER; omitted above for readability.
%% Derived PRODUCT_UNIT columns are written only by services/lifecycle.py. See docs/SCHEMA.md for rules per table.
