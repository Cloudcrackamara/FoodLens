erDiagram

    APP_USER {
        uuid user_id PK
        string email UK "stored lowercased"
        string password_hash
        string display_name
        boolean is_admin "seed/CLI only"
        boolean is_active
        datetime created_at
        datetime updated_at
    }

    USER_SESSION {
        uuid session_id PK
        uuid user_id FK
        string token_hash UK "hash only, never the token"
        datetime expires_at
        datetime revoked_at "nullable"
        datetime created_at
    }

    COMPANY {
        uuid company_id PK
        enum company_type "MANUFACTURER, WHOLESALER, BOTH"
        string display_name
        string contact_email
        string contact_phone "nullable"
        string claimed_legal_name "claimed, unverified"
        string claimed_business_identifier "claimed, nullable"
        string claimed_address "claimed, nullable"
        enum review_status "PENDING_REVIEW, APPROVED, REJECTED, SUSPENDED"
        uuid reviewed_by_user_id FK "nullable"
        datetime reviewed_at "nullable"
        string review_note "nullable"
        datetime created_at
        datetime updated_at
    }

    COMPANY_MEMBER {
        uuid member_id PK
        uuid user_id FK,UK "one company per user"
        uuid company_id FK
        enum role "OWNER, REPRESENTATIVE"
        enum membership_status "ACTIVE, INACTIVE"
        boolean is_public_contact
        string public_title "nullable"
        string public_phone "nullable"
        string public_email "nullable"
        datetime created_at
        datetime updated_at
    }

    SUPPLIER_LOCATION {
        uuid location_id PK
        uuid company_id FK
        string name
        string address
        string area
        uuid contact_member_id FK "nullable"
        enum review_status "PENDING_REVIEW, APPROVED, REJECTED"
        uuid reviewed_by_user_id FK "nullable"
        datetime reviewed_at "nullable"
        string review_note "nullable"
        datetime created_at
        datetime updated_at
    }

    PRODUCT {
        uuid product_id PK
        uuid company_id FK
        string name
        string brand
        string category
        string product_code UK
        string package_size "nullable"
        string manufacturer_name
        text label_information "nullable"
        enum status "DRAFT, PENDING_REVIEW, PUBLISHED, REJECTED, WITHDRAWN"
        uuid reviewed_by_user_id FK "nullable"
        datetime reviewed_at "nullable"
        string review_note "nullable"
        datetime created_at
        datetime updated_at
    }

    PRODUCT_BATCH {
        uuid batch_id PK
        uuid product_id FK "UK with batch_number"
        string batch_number
        date production_date "nullable"
        date expiry_date "nullable, >= production_date"
        string qr_token UK "nullable, opaque"
        enum review_status "PENDING_REVIEW, APPROVED, REJECTED"
        uuid reviewed_by_user_id FK "nullable"
        datetime reviewed_at "nullable"
        string review_note "nullable"
        datetime created_at
        datetime updated_at
    }

    REGULATORY_AGENCY {
        uuid agency_id PK
        string name "e.g. NAFDAC (simulated); UK with scheme"
        string scheme
        enum data_mode "DEMO"
        datetime created_at
        datetime updated_at
    }

    CREDENTIAL_RECORD {
        uuid credential_id PK
        uuid product_id FK "product-level only"
        uuid agency_id FK "UK with reference_number"
        string reference_number "DEMO- prefix"
        enum status "ACTIVE, INACTIVE"
        date valid_from "nullable"
        date valid_until "nullable, >= valid_from"
        enum data_mode "DEMO"
        text provenance
        date checked_on
        uuid submitted_by_user_id FK "nullable for seed"
        enum review_status "PENDING_REVIEW, APPROVED, REJECTED"
        uuid reviewed_by_user_id FK "nullable"
        datetime reviewed_at "nullable"
        string review_note "nullable"
        datetime created_at
        datetime updated_at
    }

    CHANGE_NOTICE {
        uuid notice_id PK
        uuid company_id FK
        uuid product_id FK "exactly one target set"
        uuid batch_id FK "exactly one target set"
        uuid credential_id FK "exactly one target set"
        uuid location_id FK "exactly one target set"
        enum change_type
        text reason
        date effective_date "nullable"
        uuid submitted_by_user_id FK
        enum review_status "PENDING_REVIEW, CLARIFICATION_REQUESTED, APPROVED, REJECTED"
        uuid reviewed_by_user_id FK "nullable"
        datetime reviewed_at "nullable"
        string review_note "nullable"
        datetime created_at
        datetime updated_at
    }

    CHANGE_NOTICE_FIELD {
        uuid field_change_id PK
        uuid notice_id FK "UK with field_name"
        string field_name
        text current_value "snapshot at submission"
        text proposed_value
        text applied_old_value "set on approval"
        datetime created_at
    }

    NOTICE_ATTACHMENT {
        uuid attachment_id PK
        uuid notice_id FK
        string storage_key UK "private"
        string original_filename
        enum mime_type "application/pdf, image/png, image/jpeg"
        int size_bytes "1 to 5 MB"
        datetime created_at
    }

    PRODUCT_ANNOUNCEMENT {
        uuid announcement_id PK
        uuid product_id FK
        string title
        text message
        string image_storage_key "nullable"
        enum status "LIVE, HIDDEN"
        uuid created_by_user_id FK
        uuid hidden_by_user_id FK "nullable, admin"
        datetime hidden_at "nullable"
        datetime created_at
        datetime updated_at
    }

    AUDIT_LOG {
        uuid audit_id PK
        uuid actor_user_id FK "nullable for system"
        string entity_type
        uuid entity_id
        string action
        jsonb old_values "nullable"
        jsonb new_values "nullable"
        datetime created_at
    }

    WHOLESALE_ORDER {
        uuid order_id PK
        uuid buyer_company_id FK "differs from seller"
        uuid seller_company_id FK
        uuid created_by_user_id FK
        uuid pickup_location_id FK "nullable"
        enum fulfilment_method "PICKUP, DELIVERY"
        text delivery_details "nullable"
        enum status "SUBMITTED, ACCEPTED, DECLINED, FULFILLED, CANCELLED"
        text buyer_note "nullable"
        text seller_note "nullable"
        datetime created_at
        datetime updated_at
    }

    ORDER_LINE {
        uuid line_id PK
        uuid order_id FK
        uuid product_id FK
        decimal quantity "> 0"
        string unit
        datetime created_at
    }

    ORDER_BATCH_ALLOCATION {
        uuid allocation_id PK
        uuid line_id FK
        uuid batch_id FK "must belong to line product (service)"
        decimal allocated_quantity "> 0"
        datetime created_at
    }

    BATCH_SCAN {
        uuid scan_id PK "PHASE 8 - not yet migrated"
        string input_product_code
        string input_batch_number
        uuid matched_batch_id FK "nullable"
        string result
        datetime created_at
    }

    CONCERN_REPORT {
        uuid report_id PK "PHASE 8 - not yet migrated"
        uuid product_id FK "nullable"
        uuid batch_id FK "nullable"
        string product_code_entered "snapshot"
        string batch_number_entered "snapshot"
        string concern_type
        text description
        string purchase_area "nullable"
        string contact_email "nullable, optional PII"
        string photo_storage_key "nullable, private"
        string status
        datetime created_at
    }

    APP_USER ||--o{ USER_SESSION : "signs in with"
    APP_USER ||--o| COMPANY_MEMBER : "belongs via"
    COMPANY ||--o{ COMPANY_MEMBER : "has"
    COMPANY ||--o{ PRODUCT : "owns"
    COMPANY ||--o{ SUPPLIER_LOCATION : "operates"
    COMPANY_MEMBER o|--o{ SUPPLIER_LOCATION : "is contact for"
    COMPANY ||--o{ CHANGE_NOTICE : "submits"
    COMPANY ||--o{ WHOLESALE_ORDER : "buys in"
    COMPANY ||--o{ WHOLESALE_ORDER : "sells in"
    PRODUCT ||--o{ PRODUCT_BATCH : "has"
    PRODUCT ||--o{ CREDENTIAL_RECORD : "credentialed by"
    PRODUCT ||--o{ PRODUCT_ANNOUNCEMENT : "announced in"
    REGULATORY_AGENCY ||--o{ CREDENTIAL_RECORD : "issues (simulated)"
    PRODUCT o|--o{ CHANGE_NOTICE : "target"
    PRODUCT_BATCH o|--o{ CHANGE_NOTICE : "target"
    CREDENTIAL_RECORD o|--o{ CHANGE_NOTICE : "target"
    SUPPLIER_LOCATION o|--o{ CHANGE_NOTICE : "target"
    CHANGE_NOTICE ||--|{ CHANGE_NOTICE_FIELD : "proposes"
    CHANGE_NOTICE ||--o{ NOTICE_ATTACHMENT : "supported by"
    WHOLESALE_ORDER ||--|{ ORDER_LINE : "contains"
    PRODUCT ||--o{ ORDER_LINE : "ordered as"
    ORDER_LINE ||--o{ ORDER_BATCH_ALLOCATION : "fulfilled by"
    PRODUCT_BATCH ||--o{ ORDER_BATCH_ALLOCATION : "allocated in"
    SUPPLIER_LOCATION o|--o{ WHOLESALE_ORDER : "pickup at"
    APP_USER o|--o{ AUDIT_LOG : "acts in"
    PRODUCT_BATCH o|--o{ BATCH_SCAN : "optional match (Phase 8)"
    PRODUCT o|--o{ CONCERN_REPORT : "optional match (Phase 8)"
    PRODUCT_BATCH o|--o{ CONCERN_REPORT : "optional match (Phase 8)"

%% Matches backend/app/models and migration 0002_initial_schema (2026-10-07).
%% Migrations are the source of truth; see docs/SCHEMA.md for rules per table.
%% Every reviewer FK (reviewed_by_user_id, hidden_by_user_id) references APP_USER; omitted above for readability.
%% BATCH_SCAN and CONCERN_REPORT are planned for Phase 8 and do not exist in the database yet.
