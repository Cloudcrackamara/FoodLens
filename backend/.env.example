# Copy to backend/.env and adjust. Never commit backend/.env.
APP_ENV=development
DATABASE_URL=postgresql+psycopg://foodlens:foodlens_dev@localhost:5433/foodlens
TEST_DATABASE_URL=postgresql+psycopg://foodlens:foodlens_dev@localhost:5433/foodlens_test
CORS_ORIGINS=["http://localhost:3000"]

# Auth sessions (httpOnly cookie). Set SESSION_COOKIE_SECURE=true anywhere served over HTTPS.
SESSION_TTL_HOURS=24
SESSION_COOKIE_SECURE=false
BCRYPT_ROUNDS=12

# Seed admin, created or promoted by `uv run python -m app.seed`. Leave blank to skip.
# Use a password of 10+ characters that you do not use anywhere else.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_DISPLAY_NAME=FoodLens Demo Admin
# Password for buyer@demo.foodlens.invalid and seller@demo.foodlens.invalid (demo orders).
# Leave blank and those accounts cannot sign in.
SEED_DEMO_PASSWORD=

# Rate limits, per client network (IP address). No cookies or other identifiers are used.
# Consumer checks: token bucket, a burst of N requests, then REFILL_PER_SECOND more each second.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_CHECK_BURST=20
RATE_LIMIT_CHECK_REFILL_PER_SECOND=1
RATE_LIMIT_LOGIN_PER_MINUTE=5
RATE_LIMIT_REGISTER_PER_HOUR=5
# Anonymous consumer concern reports, per network.
RATE_LIMIT_REPORT_PER_HOUR=5
# Comma-separated IPs or CIDR ranges never limited (e.g. usability-test laptops).
RATE_LIMIT_EXEMPT_IPS=
# Proxies whose X-Forwarded-For is trusted (the Next.js server on this machine).
TRUSTED_PROXY_IPS=127.0.0.1,::1

# Base URL printed in every QR code: {PUBLIC_BASE_URL}/p/{token}. Labels are permanent once
# printed, so set the real domain (https://foodlens.online) before printing real labels.
PUBLIC_BASE_URL=http://localhost:3000

# Consumer checks. A sale this many hours old or newer shows as "just sold" (D115).
JUST_SOLD_WINDOW_HOURS=6
# Coarse area for each check (D118): Cloudflare location headers through a trusted tunnel,
# then this offline DB-IP Lite city file (.mmdb, https://db-ip.com/db/lite.php), then the
# demo city picker. The IP is discarded straight after. Blank skips the file lookup.
GEOIP_DB_PATH=
# Demo only, off by default: the check page offers a city picker for the demo scenario.
SIMULATE_LOCATION_ENABLED=false

# POS integration (docs/POS_INTEGRATION.md). POS_SECRET_KEY is a Fernet key that encrypts each
# partner's signing secret at rest. Blank turns the POS API off (503) and the seed skips the demo
# partner. Generate one with:
#   uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Never commit it. Changing it makes existing partner secrets unreadable (re-run the seed for the
# demo partner; real partners need a new secret).
POS_SECRET_KEY=
# Signed requests more than this many seconds off the server clock, either way, are refused.
POS_MAX_SKEW_SECONDS=300
# Late offline events are accepted up to this age; events more than this far ahead are refused.
POS_MAX_EVENT_AGE_DAYS=7
POS_MAX_FUTURE_SECONDS=300
POS_MAX_UNITS_PER_REQUEST=100
# Per-partner token bucket.
RATE_LIMIT_POS_BURST=60
RATE_LIMIT_POS_REFILL_PER_SECOND=5
# Demo only, off by default: the simulated till at /demo/pos (also set
# NEXT_PUBLIC_DEMO_POS_ENABLED=true in frontend/.env.local).
DEMO_POS_ENABLED=false

# Wholesale order requests are hidden future work (D127). true registers the order routes.
ORDERS_ENABLED=false

# Private folder for change-notice attachments, relative to backend/. Never served statically.
UPLOAD_DIR=storage/notices
